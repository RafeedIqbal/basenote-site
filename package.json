    "@payloadcms/storage-vercel-blob": "3.94.0",
    "google-auth-library": "^11.1.0",
    "graphql": "16.15.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.18",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
